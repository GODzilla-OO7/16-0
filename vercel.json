{
  "redirects": [
    {
      "source": "/t/:code",
      "destination": "https://tinyurl.com/:code",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/s/:code",
      "destination": "/index.html"
    },
    {
      "source": "/:code([a-z0-9]{5,7})",
      "destination": "/index.html"
    }
  ]
}
